# Database configuration
# IMPORTANT: Never commit real credentials. Set these as environment variables in your deployment platform.
# A database password was previously exposed in logs and must be rotated in DigitalOcean
# (Databases → moranode-db → Users → doadmin → Reset password).
DB_NAME=moranode_db
DB_USER=doadmin
DB_PASSWORD=your-database-password-here

# Spring Boot datasource (used by the app service)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=doadmin
SPRING_DATASOURCE_PASSWORD=your-database-password-here
